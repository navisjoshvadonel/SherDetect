# SherDetect Environment Configuration Template
# Copy this file to .env.local in frontend/ and .env in root

# ── Google Gemini AI API Key ──────────────────────────────────────────────────
# Optional: for multimodal forensic semantic reasoning (Layer 6)
# If not provided, SherDetect activates its zero-downtime offline heuristics.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase Configuration ────────────────────────────────────────────────────
# Get your Project URL and Anon Key from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Backend API URLs ──────────────────────────────────────────────────────────
# Backend FastAPI (backend/app/main.py) — runs on port 8001 (with Supabase persistence)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# Primary AI Engine (ai_engine/server.py) — runs on port 8000
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000

# ── Frontend Port ─────────────────────────────────────────────────────────────
PORT=3000
